# Backend URL for the Vite dev-server /api proxy (and WebSockets).
# Default if unset: http://127.0.0.1:8000
#
# Copy to .env and adjust when uvicorn is not on 8000:
#   cp env.example .env
#
# Example — local uvicorn on 8001 (production may already use 8000):
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
