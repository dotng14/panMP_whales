// Experiment 5 — Approach A: sticky categorical HMM over motif (+ gap) tokens
// T theme states chosen on train (example drawn with T=4). No fixed cycle.
// Render: dot -Tpng approachA_sticky_categorical_hmm.dot -o approachA_sticky_categorical_hmm.png

digraph ApproachA_StickyCategoricalHMM {
  rankdir=LR;
  labelloc="t";
  label="Approach A: sticky categorical HMM\nobservations = motif ids + GAP_S / GAP_L / BREAK\nT chosen on train (example T=4); thick edges = sticky self-loops";
  fontsize=12;
  fontname="Helvetica";
  node [shape=circle, style=filled, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  start [label="start", shape=plaintext, fillcolor=white];

  T1 [label="Theme 1", fillcolor="#a6cee3"];
  T2 [label="Theme 2", fillcolor="#b2df8a"];
  T3 [label="Theme 3", fillcolor="#fdbf6f"];
  T4 [label="Theme 4", fillcolor="#cab2d6"];
  Sil [label="Silence\n(GAP_L / BREAK)", shape=ellipse, fillcolor="#eeeeee"];

  start -> T1 [label="π"];
  start -> T2;
  start -> T3;
  start -> T4;
  start -> Sil;

  // sticky self-loops (high probability)
  T1 -> T1 [label="≈1-ε", penwidth=3];
  T2 -> T2 [label="≈1-ε", penwidth=3];
  T3 -> T3 [label="≈1-ε", penwidth=3];
  T4 -> T4 [label="≈1-ε", penwidth=3];
  Sil -> Sil [label="sticky", penwidth=3];

  // flexible theme changes (no forced order)
  T1 -> T2 [label="ε/(T-1)", style=dashed];
  T1 -> T3 [style=dashed];
  T1 -> T4 [style=dashed];
  T2 -> T1 [style=dashed];
  T2 -> T3 [style=dashed];
  T2 -> T4 [style=dashed];
  T3 -> T1 [style=dashed];
  T3 -> T2 [style=dashed];
  T3 -> T4 [style=dashed];
  T4 -> T1 [style=dashed];
  T4 -> T2 [style=dashed];
  T4 -> T3 [style=dashed];

  T1 -> Sil [style=dotted];
  T2 -> Sil [style=dotted];
  T3 -> Sil [style=dotted];
  T4 -> Sil [style=dotted];
  Sil -> T1 [style=dotted];
  Sil -> T2 [style=dotted];
  Sil -> T3 [style=dotted];
  Sil -> T4 [style=dotted];

  emit [shape=note, fillcolor="#fff7bc", label="Emission per theme state:\ncategorical over motif vocabulary\n(+ gap tokens)\nlearned by Baum–Welch on train"];
  boundary [shape=note, fillcolor="#fbb4ae", label="Boundary =\ntime of first token where\ndecoded theme state changes\n(Viterbi path)"];
}
