# Copy to .env and restart the server:  cp env.example .env

# Server-side WAV folders for the library file picker (comma-separated; quote if spaces).
# WAV_LIBRARY_ROOTS=/data/recordings
WAV_LIBRARY_ROOTS=

# Panel time-axis cap (default 65536). Each column is one browser pixel horizontally.
# panel.bin v2 stores uint8 magnitude (~freqBins × timeCols bytes) plus small energy arrays.
# Lower to shrink panel.bin; raise for more detail on very long files.
# GPL_MAX_DISPLAY_COLS=65536

# From the repo root: pip install -e .   (or pip install -e '.[gpu]' on CUDA hosts).
# GPL_COMPUTE=cpu          # default; no NVIDIA GPU needed
# GPL_COMPUTE=cuda
# GPL_NUM_GPUS=2           # parallel windows; match visible GPU count
# CUDA_VISIBLE_DEVICES=0,1 # which physical GPUs to use (NVIDIA env var)

# Production only: comma-separated origins allowed by the CORS middleware.
# Required when the frontend is served from a public domain via nginx.
# CORS_ORIGINS=http://yourdomain.com,https://yourdomain.com
# Catalog of dictionaries, MP runs and song-structure CSVs (see database/README.md).
# CATALOG_DB=/path/to/catalog.sqlite          # default: backend/data/catalog.sqlite
# CATALOG_RUNS_ROOTS=/data/dict_runs          # comma-separated; scanned by POST /api/catalog/reindex
# CATALOG_CSV_ROOTS=/data/song_structure      # comma-separated; default: backend/data/song_structure
